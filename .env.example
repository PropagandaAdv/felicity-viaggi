# Copia questo file in .env.local (sviluppo) o imposta le variabili sull'hosting (produzione).
# Se una variabile è vuota, la funzione relativa resta spenta o usa il ripiego indicato.

# Google Tag Manager: es. GTM-XXXXXXX. Vuoto = GTM non viene caricato (il dataLayer si popola comunque).
VITE_GTM_ID=

# Meta Pixel: es. 123456789012345. Vuoto = Pixel non caricato.
VITE_META_PIXEL_ID=

# Endpoint POST JSON del modulo preventivo (Formspree, CRM, webhook). Vuoto = ripiego mailto verso info@felicityviaggi.it.
VITE_FORM_ENDPOINT=

# Endpoint POST JSON per l'iscrizione alla newsletter (Brevo, Mailchimp via webhook, ecc.). Vuoto = ripiego mailto.
VITE_NEWSLETTER_ENDPOINT=
